# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=budgetbite

# Allowed CORS Origins (comma-separated for production frontend URLs)
ALLOWED_ORIGINS=https://budgetbite.vercel.app,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Server Port (automatically provided by Render / Koyeb in production)
PORT=8000
HOST=0.0.0.0
