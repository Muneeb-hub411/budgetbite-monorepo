# Backend API URL (Production Render / Koyeb URL or local development server)
# In production on Vercel, set this to your hosted backend URL:
# e.g. https://budgetbite-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional server-side only backend URL (overrides NEXT_PUBLIC_API_URL in API routes if provided)
BACKEND_API_URL=http://127.0.0.1:8000
